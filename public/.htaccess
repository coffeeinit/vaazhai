<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let existing files and folders be served normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect all other routes (like /story) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
